{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "color": "#000000", "name": "Primary" },
        { "slug": "secondary", "color": "#ffffff", "name": "Secondary" },
        { "slug": "accent", "color": "#f04d4f", "name": "Accent (Cart Red)" },
        { "slug": "nav-gray", "color": "#7a7a7a", "name": "Nav Gray" },
        { "slug": "teal", "color": "#43c2d2", "name": "Teal" }
      ],
      "gradients": [
        {
          "slug": "header-fade",
          "gradient": "linear-gradient(180deg, #ffffff 0%, #dbffff 100%)",
          "name": "Header Fade"
        }
      ],
      "custom": true,
      "customDuotone": true,
      "customGradient": true
    },
    "typography": {
      "fontSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "16px",
          "fluid": { "min": "14px", "max": "16px" }
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "18px",
          "fluid": { "min": "16px", "max": "18px" }
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "22px",
          "fluid": { "min": "18px", "max": "22px" }
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "28px",
          "fluid": { "min": "20px", "max": "28px" }
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "38px",
          "fluid": { "min": "26px", "max": "38px" }
        },
        {
          "slug": "xl",
          "name": "Extra Large",
          "size": "60px",
          "fluid": { "min": "36px", "max": "60px" }
        },
        {
          "slug": "2xl",
          "name": "2X Large",
          "size": "80px",
          "fluid": { "min": "48px", "max": "80px" }
        },
        {
          "slug": "3xl",
          "name": "3X Large",
          "size": "96px",
          "fluid": { "min": "50px", "max": "96px" }
        }
      ],
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "'League Spartan', sans-serif",
          "slug": "futura-condensed",
          "name": "League Spartan"
        },
        {
          "fontFamily": "'Jost', sans-serif",
          "slug": "futura",
          "name": "Jost"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw"]
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
